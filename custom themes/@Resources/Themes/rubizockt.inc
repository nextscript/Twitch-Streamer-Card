[Variables]
ThemeName=rubizockt
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\rubizockt.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (matched to the dark orange panel design) ---
ColorBgTop=15,11,10,255
ColorBgBottom=28,16,10,255
ColorAccent=255,145,0,255
ColorAccent2=255,101,0,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=255,246,233,255
ColorTitle2=255,185,83,255
TitleEffect=Shadow
ColorSubtitle=255,172,65,255
ColorIcon=255,151,0,255
ColorIconHover=255,202,83,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\rubizockt_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons and labels are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=255,248,240,255
ColorValue2=255,190,103,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
