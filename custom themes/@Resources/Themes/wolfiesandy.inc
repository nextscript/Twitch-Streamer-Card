[Variables]
ThemeName=wolfiesandy
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\wolfiesandy.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=37,21,33,255
ColorBgBottom=36,21,32,255
ColorAccent=145,102,62,255
ColorAccent2=116,82,50,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=198,158,121,255
ColorTitle2=186,137,92,255
TitleEffect=Shadow
ColorSubtitle=186,138,93,255
ColorIcon=170,120,73,255
ColorIconHover=198,159,122,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\wolfiesandy_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=200,161,125,255
ColorValue2=187,140,96,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
