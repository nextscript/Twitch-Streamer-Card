[Variables]
ThemeName=danergy
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\danergy.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=34,10,59,255
ColorBgBottom=33,9,65,255
ColorAccent=143,17,218,255
ColorAccent2=118,14,180,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=205,137,246,255
ColorTitle2=193,108,244,255
TitleEffect=Shadow
ColorSubtitle=193,109,244,255
ColorIcon=179,76,241,255
ColorIconHover=209,147,247,255
HeaderIndent=50
HeaderIndentY=-10
ImgAvatar=#ThemesPath#Images\danergy_avatar.png
AvatarSize=45
AvatarX=-7
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=112,13,171,255
ColorValue2=127,15,194,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
