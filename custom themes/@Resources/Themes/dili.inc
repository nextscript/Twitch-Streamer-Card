[Variables]
ThemeName=dili
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\dili.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=193,130,135,255
ColorBgBottom=196,132,136,255
ColorAccent=204,153,118,255
ColorAccent2=193,131,88,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=20,20,20,255
ColorTitle2=37,23,14,255
TitleEffect=Shadow
ColorSubtitle=38,24,14,255
ColorIcon=60,38,22,255
ColorIconHover=4,3,1,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\dili_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=218,181,155,255
ColorValue2=200,145,106,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
