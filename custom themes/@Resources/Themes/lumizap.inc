[Variables]
ThemeName=lumizap
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\lumizap.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=224,207,250,255
ColorBgBottom=211,206,251,255
ColorAccent=145,162,244,255
ColorAccent2=108,131,240,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=16,43,174,255
ColorTitle2=21,53,215,255
TitleEffect=Shadow
ColorSubtitle=21,53,210,255
ColorIcon=38,72,233,255
ColorIconHover=18,46,177,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\lumizap_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=20,54,216,255
ColorValue2=38,71,234,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
