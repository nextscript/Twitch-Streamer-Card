[Variables]
ThemeName=myun
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\myun.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=37,26,32,255
ColorBgBottom=66,40,48,255
ColorAccent=183,127,86,255
ColorAccent2=160,107,68,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=201,159,129,255
ColorTitle2=189,138,101,255
TitleEffect=Shadow
ColorSubtitle=189,138,100,255
ColorIcon=183,127,86,255
ColorIconHover=206,168,140,255
HeaderIndent=50
HeaderIndentY=-5
ImgAvatar=#ThemesPath#Images\myun_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=213,181,158,255
ColorValue2=200,157,126,255
ValueEffect=Shadow
TileValueShift1=-4
TileValueShift2=16
