[Variables]
ThemeName=guyfindsgopro
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\guyfindsgopro.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=253,245,224,255
ColorBgBottom=253,245,225,255
ColorAccent=187,150,118,255
ColorAccent2=173,129,91,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=105,77,52,255
ColorTitle2=126,92,62,255
TitleEffect=Shadow
ColorSubtitle=125,92,62,255
ColorIcon=142,104,71,255
ColorIconHover=91,67,46,255
HeaderIndent=50
HeaderIndentY=-10
ImgAvatar=#ThemesPath#Images\guyfindsgopro_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=105,77,52,255
ColorValue2=126,92,62,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
