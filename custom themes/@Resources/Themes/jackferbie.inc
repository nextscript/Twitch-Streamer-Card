[Variables]
ThemeName=jackferbie
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\jackferbie.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=35,37,46,255
ColorBgBottom=35,41,46,255
ColorAccent=156,237,118,255
ColorAccent2=130,232,82,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=189,243,163,255
ColorTitle2=140,234,95,255
TitleEffect=Shadow
ColorSubtitle=156,237,118,255
ColorIcon=156,237,118,255
ColorIconHover=205,246,186,255
HeaderIndent=50
HeaderIndentY=-5
ImgAvatar=#ThemesPath#Images\jackferbie_avatar.png
AvatarSize=45
AvatarX=-8
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=189,243,163,255
ColorValue2=140,234,95,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
