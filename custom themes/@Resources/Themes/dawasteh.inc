[Variables]
ThemeName=dawasteh
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\dawasteh.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=252,239,219,255
ColorBgBottom=252,239,222,255
ColorAccent=213,134,125,255
ColorAccent2=203,105,94,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=135,54,45,255
ColorTitle2=163,64,53,255
TitleEffect=Shadow
ColorSubtitle=163,64,53,255
ColorIcon=186,73,60,255
ColorIconHover=128,50,41,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\dawasteh_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=135,54,45,255
ColorValue2=163,64,53,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
