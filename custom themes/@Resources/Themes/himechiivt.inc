[Variables]
ThemeName=himechiivt
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\himechiivt.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=50,34,38,255
ColorBgBottom=57,42,45,255
ColorAccent=164,119,80,255
ColorAccent2=137,99,67,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=205,176,151,255
ColorTitle2=190,153,121,255
TitleEffect=Shadow
ColorSubtitle=190,153,121,255
ColorIcon=176,132,93,255
ColorIconHover=201,171,144,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\himechiivt_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=213,189,168,255
ColorValue2=198,166,138,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
