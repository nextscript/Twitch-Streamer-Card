[Variables]
ThemeName=dennisvibed
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\dennisvibed.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (tropical sunset theme: violet, magenta, amber) ---
ColorBgTop=22,8,39,255
ColorBgBottom=34,11,52,255
ColorAccent=226,103,245,255
ColorAccent2=255,157,65,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=14
ColorTitle=248,244,255,255
ColorTitle2=230,207,250,255
TitleEffect=Shadow
ColorSubtitle=202,169,222,255
ColorIcon=237,154,255,255
ColorIconHover=255,205,133,255
HeaderIndent=50
HeaderIndentY=0
ImgAvatar=#ThemesPath#Images\dennisvibed_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons and labels are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=255,246,243,255
ColorValue2=249,198,128,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
