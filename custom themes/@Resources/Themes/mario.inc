[Variables]
ThemeName=mario
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\mario.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=161,161,89,255
ColorBgBottom=147,190,205,255
ColorAccent=156,155,85,255
ColorAccent2=130,129,71,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=17,17,9,255
ColorTitle2=40,40,22,255
TitleEffect=Shadow
ColorSubtitle=40,40,22,255
ColorIcon=44,43,24,255
ColorIconHover=0,0,0,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\mario_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=80,79,44,255
ColorValue2=96,96,53,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
