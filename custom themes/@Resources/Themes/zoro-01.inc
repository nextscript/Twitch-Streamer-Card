[Variables]
ThemeName=zoro-01
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\zoro-01.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=0,64,30,255
ColorBgBottom=0,60,28,255
ColorAccent=191,153,62,255
ColorAccent2=160,128,52,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=219,196,141,255
ColorTitle2=205,174,100,255
TitleEffect=Shadow
ColorSubtitle=205,174,99,255
ColorIcon=191,153,62,255
ColorIconHover=211,184,119,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\zoro-01_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=219,196,141,255
ColorValue2=205,174,100,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
