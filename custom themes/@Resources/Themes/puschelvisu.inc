[Variables]
ThemeName=puschelvisu
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\puschelvisu.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=48,38,42,255
ColorBgBottom=53,42,47,255
ColorAccent=111,126,80,255
ColorAccent2=89,101,64,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=171,185,144,255
ColorTitle2=150,166,116,255
TitleEffect=Shadow
ColorSubtitle=150,167,116,255
ColorIcon=133,151,96,255
ColorIconHover=169,183,141,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\puschelvisu_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=20,20,20,255
ColorValue2=1,1,1,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
