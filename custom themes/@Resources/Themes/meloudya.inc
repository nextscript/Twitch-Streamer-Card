[Variables]
ThemeName=meloudya1
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\meloudya.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=115,100,217,255
ColorBgBottom=173,242,255,255
ColorAccent=126,243,255,255
ColorAccent2=85,239,255,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=20,20,20,255
ColorTitle2=20,20,20,255
TitleEffect=Shadow
ColorSubtitle=20,20,20,255
ColorIcon=203,250,255,255
ColorIconHover=255,255,255,255
HeaderIndent=50
HeaderIndentY=-8
ImgAvatar=#ThemesPath#Images\meloudya_avatar.png
AvatarSize=45
AvatarX=-9
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=0,82,90,255
ColorValue2=0,100,110,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
