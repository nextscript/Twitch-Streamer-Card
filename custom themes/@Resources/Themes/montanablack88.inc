[Variables]
ThemeName=montanablack88
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\montanablack88.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=52,35,48,255
ColorBgBottom=42,28,39,255
ColorAccent=202,153,122,255
ColorAccent2=190,131,93,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=217,181,158,255
ColorTitle2=201,150,119,255
TitleEffect=Shadow
ColorSubtitle=202,153,122,255
ColorIcon=202,153,122,255
ColorIconHover=224,195,177,255
HeaderIndent=50
HeaderIndentY=0
ImgAvatar=#ThemesPath#Images\montanablack88_avatar.png
AvatarSize=45
AvatarX=-3.4
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=243,231,224,255
ColorValue2=228,203,188,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
