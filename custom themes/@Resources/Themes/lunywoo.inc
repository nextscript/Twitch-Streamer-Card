[Variables]
ThemeName=lunywoo
; Full image as background. On top of it the skin only draws
; the live values (name, status, viewers, uptime, preview, buttons).
ImgCardBack=#ThemesPath#Images\lunywoo.png
CardRadius=12
BorderWidth=0
AccentBarHeight=0

; --- Colors (automatically sampled from the image) ---
ColorBgTop=34,21,29,255
ColorBgBottom=32,21,30,255
ColorAccent=132,93,60,255
ColorAccent2=104,73,47,255
ColorLive=215,15,25,255

; --- Header (avatar + ring are part of the image, only the status dot here) ---
FontTitle=Segoe UI Bold
TitleSize=16
ColorTitle=195,157,124,255
ColorTitle2=182,136,96,255
TitleEffect=Shadow
ColorSubtitle=183,136,96,255
ColorIcon=171,120,78,255
ColorIconHover=197,159,128,255
HeaderIndent=50
HeaderIndentY=-10
ImgAvatar=#ThemesPath#Images\lunywoo_avatar.png
AvatarSize=45
AvatarX=-8
AvatarRingWidth=0
ColorAvatarRing=0,0,0,0

; --- Preview (frame + pause wreath are part of the image) ---
PreviewRadius=11
PreviewBorderWidth=0
ColorPreviewBg=0,0,0,0
ColorPreviewShade=0,0,0,120
HidePreviewViewers=1
OfflineText=

; --- Tiles (tiles, icons, labels, bunny are part of the image) ---
ColorTile=0,0,0,0
TileBorderWidth=0
ColorLabel=0,0,0,0
ColorLabelIcon=0,0,0,0
FontValue=Segoe UI Bold
ValueSize=13
ColorValue=200,165,135,255
ColorValue2=186,142,103,255
ValueEffect=Shadow
TileValueShift1=-2
TileValueShift2=16
